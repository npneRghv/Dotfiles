{
    "editor.fontFamily": "Cascadia Code, consolig, 'monospace'",
    "terminal.integrated.fontSize": 11,
    "editor.fontLigatures": true,
    "editor.lineNumbers": "relative",
    "workbench.iconTheme": "a-file-icon-vscode",
    "editor.fontSize": 10.5,
    "editor.cursorSurroundingLines": 10,
    "editor.minimap.enabled": false,
    "breadcrumbs.enabled": false,
    "keyboard.dispatch": "keyCode",
    "workbench.sideBar.location": "left",
    "terminal.integrated.fontLigatures.fallbackLigatures": [
        "<--",
        "<---",
        "<<-",
        "<-",
        "->",
        "->>",
        "-->",
        "--->",
        "<==",
        "<===",
        "<<=",
        "<=",
        "=>",
        "=>>",
        "==>",
        "===>",
        ">=",
        ">>=",
        "<->",
        "<-->",
        "<--->",
        "<---->",
        "<=>",
        "<==>",
        "<===>",
        "<====>",
        "::",
        ":::",
        "<~~",
        "</",
        "</>",
        "/>",
        "~~>",
        "==",
        "!=",
        "/=",
        "~=",
        "<>",
        "===",
        "!==",
        "!===",
        "<:",
        ":=",
        "*=",
        "*+",
        "<*",
        "<*>",
        "*>",
        "<|",
        "<|>",
        "|>",
        "+*",
        "=*",
        "=:",
        ":>",
        "/*",
        "*/",
        "+++",
        "<!--",
        "<!---"
    ],
    "workbench.startupEditor": "none",
    "explorer.autoReveal": false,

    "vim.leader": "<Space>",
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.ignorecase": true,
    "vim.smartcase": true,
    "vim.handleKeys": {
        "<C-p>": false
    },
    "vim.normalModeKeyBindingsNonRecursive": [
        // LSP navigation
        { "before": [ "g", "i" ], "commands": [ "editor.action.goToImplementation" ] },
        { "before": [ "g", "r" ], "commands": [ "editor.action.goToReferences" ] },

        // Navigation
        // Switch tabs
        { "before": ["<leader>", ","], "commands": [":bprev"] },
        { "before": ["<leader>", "."], "commands": [":bnext"] },

        // Cycle / switch editor panes / groups
        {
            "before": [ "<leader>", "p" ],
            "commands": [ "workbench.action.focusNextGroup" ]
        },

        // Save, quit, etc.
        { "before": ["<leader>", "w"], "commands": [":w!"] },
        { "before": ["<leader>", "x"], "commands": [":q"] },

        // Redo
        { "before": [ "<leader>", "r" ], "commands": [ "redo" ] },

        // Format document
        { "before": [ "<leader>", "=" ], "commands": [ "editor.action.formatDocument" ] },

        // Expand / shrink selection by syntax
        { "before": [ "<leader>", "]" ], "commands": [ "editor.action.smartSelect.expand" ] },
        { "before": [ "<leader>", "[" ], "commands": [ "editor.action.smartSelect.shrink" ] },

        // Code group
        {
            "before": ["<leader>", "c", "i"],
            "commands": ["editor.action.showHover"]
        },
        {
            "before": ["<leader>", "g", "e"],
            "commands": ["workbench.actions.view.problems"]
        },

        // Terminal
        { "before": [ "<leader>", "t" ], "commands": [ "workbench.action.terminal.toggleTerminal" ] },

        // Pin tab / keep tab open (moved to <leader>b namespace to avoid terminal delay)
        { "before": [ "<leader>", "b", "p" ], "commands": [ "workbench.action.pinEditor" ] },
        { "before": [ "<leader>", "b", "u" ], "commands": [ "workbench.action.unpinEditor" ] },
        { "before": [ "<leader>", "b", "o" ], "commands": [ "workbench.action.keepEditor" ] },

        // Switch to sidebar items
        {
            "before": [ "<leader>", "e" ],
            "commands": [ "workbench.files.action.focusFilesExplorer" ]
        },
        // Reveal / sync active file in Explorer
        {
            "before": [ "<leader>", "s", "s" ],
            "commands": [ "workbench.files.action.showActiveFileInExplorer" ]
        },
        // SQL Server / Database Explorer
        {
            "before": [ "<leader>", "s", "q", "l" ],
            "commands": [ "workbench.view.extension.objectExplorer" ]
        },
        {
            "before": [ "<leader>", "g", "g" ],
            "commands": [ "workbench.view.scm" ]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        // Format selection
        { "before": [ "<leader>", "=" ], "commands": [ "editor.action.formatSelection" ] },

        // Expand / shrink selection by syntax
        { "before": [ "<leader>", "]" ], "commands": [ "editor.action.smartSelect.expand" ] },
        { "before": [ "<leader>", "[" ], "commands": [ "editor.action.smartSelect.shrink" ] },
    ],

    "git.autofetch": true,
