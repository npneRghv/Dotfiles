" Show line numbers
set relativenumber

" Search related changes
set hlsearch
set incsearch
set ignorecase
set smartcase

" Enable autoindentation
set autoindent

" Set scroll offset
set scrolloff=10
set nowrap

" Go to implementation and references
nnoremap gi :vsc Edit.GoToImplementation<CR>
nnoremap gr :vsc Edit.FindAllReferences<CR>

" Map a leader and redo
let mapleader = ","
nnoremap <leader>r :vsc Edit.Redo<CR>

" Map database server and web server related shortcuts
nnoremap <leader>sql :vsc View.SqlServerObjectExplorer<CR>
nnoremap <leader>se :vsc View.ServerExplorer<CR>

" Apply Hot Reload changes (.NET 6+) to see Razor/C# edits instantly
nnoremap <leader>hr :vsc Debug.ApplyCodeChanges<CR>

" Automatically remove unused 'using' statements and sort them
nnoremap <leader>us :vsc Edit.RemoveAndSort<CR>

" Expand or shrink selection based on syntax blocks (C# expressions or HTML tags)
nnoremap <leader>] :vsc Edit.ExpandSelection<CR>
nnoremap <leader>[ :vsc Edit.ContractSelection<CR>

" Format document or selection
nnoremap <leader>= :vsc Edit.FormatDocument<CR>
vnoremap <leader>= :vsc Edit.FormatSelection<CR>

" Flip between Controller and its Razor View (and vice-versa)
nnoremap <leader>fv :vsc EditorContextMenus.CodeWindow.GoToView<CR>
nnoremap <leader>fc :vsc OtherContextMenus.HTMLContext.GoToController<CR>

" Navigate tabs within the current split 
nnoremap <leader>j :vsc Window.NextSplitPane<CR>
nnoremap <leader>k :vsc Window.PreviousSplitPane<CR>

" Tab related
nnoremap <leader>x :vsc Window.CloseDocumentWindow<CR>
nnoremap <leader>tp :vsc Window.PinTab<CR>
nnoremap <leader>to :vsc Window.KeepTabOpen<CR>

" Sync and collapse solution explorer
nnoremap <leader>ss :vsc SolutionExplorer.SyncWithActiveDocument<CR>

" View various tool windows
nnoremap <leader>gt :vsc View.Terminal<CR>
nnoremap <leader>e :vsc View.ErrorList<CR>
nnoremap <leader>t :vsc View.TaskList<CR>
nnoremap <leader>c :vsc View.GitWindow<CR>
nnoremap <leader>h :vsc View.GitRepositoryWindow<CR>


