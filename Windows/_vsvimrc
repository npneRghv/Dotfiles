" Show line numbers
set relativenumber

" Search related changes
set hlsearch
set incsearch
set ignorecase
set smartcase

" Enable autoindentation
set autoindent

" Set scroll offset
set scrolloff=10
set nowrap

" Use <Space> as the leader key (uniform with VS Code)
let mapleader = " "

" ===== Shared bindings (mirrored in VS Code) =====

" LSP navigation
nnoremap gi :vsc Edit.GoToImplementation<CR>
nnoremap gr :vsc Edit.FindAllReferences<CR>

" Format document or selection
nnoremap <leader>= :vsc Edit.FormatDocument<CR>
vnoremap <leader>= :vsc Edit.FormatSelection<CR>

" Expand or shrink selection based on syntax blocks (C# expressions or HTML tags)
nnoremap <leader>] :vsc Edit.ExpandSelection<CR>
nnoremap <leader>[ :vsc Edit.ContractSelection<CR>

" Redo
nnoremap <leader>r :vsc Edit.Redo<CR>

" Code actions / quick fix (lightbulb)
nnoremap <leader>ca :vsc View.QuickActions<CR>

" Quick info / hover docs
nnoremap <leader>ci :vsc Edit.QuickInfo<CR>

" Navigate to symbol
nnoremap <leader>cs :vsc Edit.GoToAll<CR>

" Diagnostics / error list
nnoremap <leader>ge :vsc View.ErrorList<CR>

" File explorer (Solution Explorer)
nnoremap <leader>e :vsc View.SolutionExplorer<CR>

" Terminal
nnoremap <leader>t :vsc View.Terminal<CR>

" Git / source control
nnoremap <leader>gg :vsc View.GitWindow<CR>

" Save and close
nnoremap <leader>w :vsc File.SaveSelectedItems<CR>
nnoremap <leader>x :vsc Window.CloseDocumentWindow<CR>

" Tab navigation
nnoremap <leader>. :vsc Window.NextTab<CR>
nnoremap <leader>, :vsc Window.PreviousTab<CR>

" Cycle horizontal split panes within the active tab group
nnoremap <leader>p :vsc Window.NextSplitPane<CR>

" ===== Visual Studio only (no VS Code equivalent) =====

" Map database server and web server related shortcuts
nnoremap <leader>sql :vsc View.SqlServerObjectExplorer<CR>
nnoremap <leader>se :vsc View.ServerExplorer<CR>

" Apply Hot Reload changes (.NET 6+) to see Razor/C# edits instantly
nnoremap <leader>hr :vsc Debug.ApplyCodeChanges<CR>

" Automatically remove unused 'using' statements and sort them
nnoremap <leader>us :vsc Edit.RemoveAndSort<CR>

" Flip between Controller and its Razor View (and vice-versa)
nnoremap <leader>fv :vsc EditorContextMenus.CodeWindow.GoToView<CR>
nnoremap <leader>fc :vsc OtherContextMenus.HTMLContext.GoToController<CR>

" Tab related (moved to <leader>b namespace to avoid terminal delay)
nnoremap <leader>bp :vsc Window.PinTab<CR>
nnoremap <leader>bu :vsc Window.PinTab<CR>
nnoremap <leader>bo :vsc Window.KeepTabOpen<CR>

" Sync and collapse solution explorer
nnoremap <leader>ss :vsc SolutionExplorer.SyncWithActiveDocument<CR>

" View various tool windows
nnoremap <leader>gt :vsc View.TaskList<CR>
nnoremap <leader>gh :vsc View.GitRepositoryWindow<CR>
